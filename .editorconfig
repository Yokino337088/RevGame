# ============================================================
# .editorconfig —— 分析器 / 代码风格设置（VS、Rider、VS Code 都认）
#
# 【为什么有这一份】
#   本框架的核心用法是"**特性驱动**"：面板 / Part 上的私有方法由特性声明
#       [RevButtonClick("btnPlay")]  [RevToggleChanged("tgSound")]  [RevSliderChanged(…)] …
#   运行时由 RevUIBinder 通过**反射**调用 —— 所以代码里根本没有任何直接调用点。
#   而 VS 的 IDE0051（"未使用的私有成员"）只看静态引用，会把这些方法判成"没人用"：
#   灰显（淡化）+ CodeLens 显示"0 个引用"。它**不看特性**，加了特性照样灰。
#
#   这里把这一类分析器关掉：由特性 + 反射调用的方法不是死代码。
#   只影响"未使用的私有成员"这一族提示，其它分析器与编译警告不受影响。
# ============================================================
root = true

[*.cs]
# 未使用的私有成员（框架里由特性 + 反射调用，静态分析看不到调用点）
dotnet_diagnostic.IDE0051.severity = none

# 已赋值但从未读取的私有成员（同样可能只由反射读取）
dotnet_diagnostic.IDE0052.severity = none

# ------------------------------------------------------------
# 只想在某个目录关闭这类提示？删掉上面两行，改成按路径分段，例如：
#
#   [Assets/Revolution.Demo/**/*.cs]
#   dotnet_diagnostic.IDE0051.severity = none
#
# 【两件与本文件相邻、但性质不同的事，避免混淆】
#   · CodeLens 的“0 个引用”是 VS 自己的功能，不受本文件影响：
#     工具 → 选项 → 文本编辑器 → 所有语言 → CodeLens（取消勾选即可）。
#   · 本文件只解决"看着别扭"。真机（IL2CPP + 托管代码裁剪）还会把
#     这类"只被特性引用、由反射调用"的方法**直接裁掉**（RevUIWidgetEvents 用
#     MethodInfo.Invoke 调它们，静态分析看不到引用）。
#     真机要稳，请给这类方法加 [Preserve]（UnityEngine.Scripting.PreserveAttribute），
#     或给业务程序集配 link.xml（本仓库目前还没有 link.xml / [Preserve]，需要时可以补）。
# ------------------------------------------------------------
