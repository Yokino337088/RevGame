  Episodes:
  - Id: opening
    Title: "\u5E8F\u7AE0 \xB7 \u88AB\u9E26\u9E26\u6361\u8D70\u7684\u5192\u9669\u5BB6"
    Portrait: {fileID: 0}
    BackgroundChapter: 0
    Lines:
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      Expression: 3
      Text: "\u9192\u4E86\u5417\uFF0C\u5192\u9669\u5BB6\uFF1F\u5148\u522B\u6025\u7740\u8D77\u8EAB\u3002\u4F60\u4ECE\u5929\u4E0A\u6389\u4E0B\u6765\u65F6\uFF0C\u53EF\u6CA1\u6709\u73B0\u5728\u8FD9\u4E48\u4F53\u9762\u3002"
    - Speaker: "\u5192\u9669\u5BB6"
      Portrait: {fileID: 0}
      Expression: 1
      Text: "\u5929\u4E0A\uFF1F\u6211\u521A\u624D\u8FD8\u5728\u73B0\u5B9E\u4E16\u754C\u2026\u2026\u8FD9\u662F\u4EC0\u4E48\u5730\u65B9\uFF1F"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      Expression: 3
      Text: "\u5F08\u9732\u5927\u9646\u3002\u8FD8\u6709\uFF0C\u6211\u53EB\u9E26\u9E26\u3002\u540D\u5B57\u8BB0\u7262\u4E00\u70B9\uFF0C\u6211\u4E0D\u559C\u6B22\u88AB\u4EBA\u53EB\u6210\u201C\u90A3\u4E2A\u5973\u7684\u201D\u3002"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      Expression: 1
      Text: "\u770B\u6211\u505A\u4EC0\u4E48\uFF1F\u6CA1\u89C1\u8FC7\u7F8E\u5973\u5417"
    - Speaker: "\u5192\u9669\u5BB6"
      Portrait: {fileID: 0}
      Expression: 11
      Text: "\u6211\u53EA\u662F\u60F3\u786E\u8BA4\uFF0C\u4F60\u771F\u7684\u613F\u610F\u5E2E\u6211\u5417"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      Expression: 23
      Text: "\u5F53\u7136\u613F\u610F(\u574F\u7B11)"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      Expression: 12
      Text: "\u628A\u773C\u795E\u6536\u56DE\u53BB\uFF0C\u8C01\u5141\u8BB8\u4F60\u7528\u8FD9\u79CD\u773C\u795E\u76EF\u7740\u672C\u9E26\u7684"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      Expression: 3
      Text: "\u5192\u9669\u5BB6\uFF0C\u50CF\u4F60\u8FD9\u79CD\u4EBA\u7C7B\u5728\u6211\u4EEC\u8FD9\u91CC\u53EF\u662F\u5F88\u53D7\u6B22\u8FCE\u7684\u5462"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      Expression: 1
      Text: "\u60F3\u56DE\u5230\u539F\u6765\u7684\u4E16\u754C\uFF0C\u5C31\u966A\u6211\u627E\u9F50\u516D\u9875\u5931\u6563\u7684\u68CB\u8C31\u3002\u4F60\u8D1F\u8D23\u843D\u5B50\uFF0C\u6211\u8D1F\u8D23\u76D1\u7763\u4F60"
    - Speaker: "\u5192\u9669\u5BB6"
      Portrait: {fileID: 0}
      Expression: 13
      Text: "\u6211\u6709\u7684\u9009\u5417"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      Expression: 1
      Text: "\u6709\u5440\u3002\u4F60\u53EF\u4EE5\u7559\u4E0B\u6765\u7ED9\u6211\u505A\u5BB6\u52A1\u3002\u4E0D\u8FC7\uFF0C\u4F60\u521A\u624D\u63E1\u7D27\u6211\u7684\u624B\u65F6\uFF0C\u770B\u7740\u53EF\u4E0D\u50CF\u60F3\u62D2\u7EDD\u3002"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      Expression: 11
      Text: "\u60F3\u597D\u4E86\u5417\uFF0C\u5192\u9669\u5BB6\uFF0C\u4F60\u662F\u8981\u7ED9\u6211\u5F53\u4E00\u8F88\u5B50\u7684\u5BB6\u653F\u5458\u5DE5\u8FD8\u662F\u8D76\u7D27\u96C6\u9F50\u516D\u9875\u5931\u6563\u7684\u68CB\u8C31\u5462"
    PortraitAtlasNames:
    - YayaExpressions
  - Id: tutorial
    Title: "\u7B2C\u4E00\u8BFE \xB7 \u522B\u8BA9\u6211\u767D\u6551\u4F60"
    Portrait: {fileID: 0}
    BackgroundChapter: 0
    Lines:
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      Expression: 3
      Text: "\u68CB\u5B50\u4F1A\u81EA\u5DF1\u6218\u6597\uFF0C\u4F60\u8981\u505A\u7684\u662F\u628A\u540C\u4F34\u6446\u5230\u5408\u9002\u7684\u4F4D\u7F6E\u3002\u4E0D\u662F\u628A\u4ED6\u4EEC\u968F\u4FBF\u5806\u5728\u4E00\u8D77\u61C2\u5417"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      Expression: 1
      Text: "\u8FDE\u7ED3\u3001\u7559\u773C\u3001\u5C01\u6C14\u3001\u6362\u4F4D\u3002\u542C\u4E0D\u61C2\u4E5F\u6CA1\u5173\u7CFB\uFF0C\u6211\u4F1A\u5728\u65C1\u8FB9\u76D1\u7763\u4F60"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      Expression: 13
      Text: "\u6253\u8D62\u4E86\u597D\u6CA1\u5956\u52B1\uFF0C\u6253\u8F93\u4E86\u6709\u60E9\u7F5A"
    - Speaker: "\u5192\u9669\u5BB6"
      Portrait: {fileID: 0}
      Expression: 13
      Text: "\u4EC0\u4E48\u60E9\u7F5A\uFF1F(\u60B2)"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      Expression: 23
      Text: "\u7B49\u4E00\u4E0B\u4F60\u5C31\u77E5\u9053\u4E86(\u574F\u7B11)"
    PortraitAtlasNames:
    - YayaExpressions
  - Id: lesson
    Title: "\u9E26\u9E26\u7684\u5B9E\u6218\u63D0\u9192"
    Portrait: {fileID: 0}
    BackgroundChapter: 1
    Lines:
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      Expression: 3
      Text: "\u5148\u9009\u5DE6\u4FA7\u9B54\u6CD5\u6846\u4E2D\u7684\u5251\u58EB\u624B\u724C\u3002\u770B\u68CB\u76D8\uFF0C\u522B\u603B\u770B\u6211\u3002"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      Expression: 1
      Text: "\u654C\u4EBA\u53EA\u5269\u4E0B\u65B9\u90A3\u4E00\u53E3\u6C14\u3002\u628A\u68CB\u5B50\u653E\u5230\u9AD8\u4EAE\u7A7A\u683C\uFF0C\u8BD5\u8BD5\u8BA9\u5B83\u65E0\u8DEF\u53EF\u8D70\u3002"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      Expression: 23
      Text: "\u96F6\u6C14\u9650\u5236\u884C\u52A8\uFF0C\u53EF\u4E0D\u662F\u4E00\u53E5\u5492\u8BED\u5C31\u628A\u751F\u547D\u6263\u5149\u3002\u73B0\u5728\u9009\u4E2D\u5DE6\u8FB9\u7684\u5DF1\u65B9\u68CB\u5B50\u3002"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      Expression: 3
      Text: "\u79FB\u5230\u5DE6\u4FA7\u9AD8\u4EAE\u7A7A\u683C\u3002\u770B\u5230\u4E86\u5417\uFF1F\u4F60\u8BA9\u51FA\u4F4D\u7F6E\uFF0C\u5B83\u5C31\u6062\u590D\u4E86\u4E00\u53E3\u6C14\u3002\u6BCF\u4E00\u6B65\u90FD\u8981\u60F3\u6E05\u695A\u3002"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      Expression: 11
      Text: "\u505A\u5F97\u4E0D\u9519\u3002\u522B\u7B11\u90A3\u4E48\u5F97\u610F\u2026\u2026\u6211\u53EA\u5938\u8FD9\u4E00\u6B21\u3002\u7B49\u51C6\u5907\u589E\u76CA\u62B5\u8FBE\uFF0C\u518D\u70B9\u5F00\u59CB\u6218\u6597\u3002"
    PortraitAtlasNames:
    - YayaExpressions
  - Id: chapter1
    Title: "\u7B2C\u4E00\u7AE0 \xB7 \u5979\u7684\u5C0F\u8003\u9A8C"
    Portrait: {fileID: 0}
    BackgroundChapter: 1
    Lines:
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      Expression: 3
      Text: "\u524D\u9762\u662F\u661F\u843D\u5C0F\u5F84\u3002\u7B2C\u4E00\u5F20\u68CB\u8C31\u5728\u5C3D\u5934\uFF0C\u6CBF\u8DEF\u7684\u5BB6\u4F19\u4F1A\u7528\u5B9E\u529B\u8DDF\u4F60\u6253\u62DB\u547C\u3002"
    - Speaker: "\u5192\u9669\u5BB6"
      Portrait: {fileID: 0}
      Expression: 1
      Text: "\u4F60\u7684\u6253\u62DB\u547C\u65B9\u5F0F\u4E5F\u8FD9\u4E48\u5371\u9669\uFF1F"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      Expression: 1
      Text: "\u770B\u5BF9\u8C61\u3002\u5BF9\u4F60\uFF0C\u6211\u5DF2\u7ECF\u5F88\u6E29\u67D4\u4E86\u3002\u522B\u8BA9\u6211\u89C9\u5F97\u6361\u9519\u4E86\u4EBA\u3002"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      Expression: 11
      Text: "\u56DE\u6765\u65F6\u8BB0\u5F97\u53EB\u6211\u3002\u4E0D\u662F\u62C5\u5FC3\u4F60\uFF0C\u53EA\u662F\u2026\u2026\u6211\u5F97\u786E\u8BA4\u8FD9\u7B14\u6295\u8D44\u6709\u6CA1\u6709\u4E8F\u3002"
    PortraitAtlasNames:
    - YayaExpressions
  - Id: chapter2
    Title: "\u7B2C\u4E8C\u7AE0 \xB7 \u4E0D\u8BB8\u4E71\u6536\u9080\u8BF7"
    Portrait: {fileID: 0}
    BackgroundChapter: 2
    Lines:
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      Expression: 3
      Text: "\u9752\u85E4\u6751\u7684\u5C45\u6C11\u5F88\u70ED\u60C5\uFF0C\u70ED\u60C5\u5230\u4F1A\u628A\u51B3\u6597\u5F53\u4F5C\u62DB\u5F85\u3002\u5148\u770B\u654C\u9635\uFF0C\u518D\u4E0B\u7B2C\u4E00\u9897\u68CB\u3002"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      Expression: 23
      Text: "\u5982\u679C\u6709\u4EBA\u8BF7\u4F60\u7559\u4E0B\u559D\u8336\uFF0C\u4F60\u6700\u597D\u60F3\u60F3\u8C01\u8FD8\u5728\u7B49\u4F60\u3002"
    - Speaker: "\u5192\u9669\u5BB6"
      Portrait: {fileID: 0}
      Expression: 1
      Text: "\u4F60\u4E0D\u662F\u8BF4\u4E0D\u62C5\u5FC3\u6211\u5417\uFF1F"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      Expression: 13
      Text: "\u6211\u62C5\u5FC3\u7684\u662F\u5BB6\u52A1\u6CA1\u4EBA\u505A\uFF01\u2026\u2026\u4F60\u7B11\u591F\u4E86\u6CA1\u6709\uFF1F\u8D70\u4E86\u3002"
    PortraitAtlasNames:
    - YayaExpressions
  - Id: chapter3
    Title: "\u7B2C\u4E09\u7AE0 \xB7 \u6C34\u9762\u91CC\u7684\u771F\u5FC3\u8BDD"
    Portrait: {fileID: 0}
    BackgroundChapter: 3
    Lines:
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      Expression: 3
      Text: "\u9B54\u6CD5\u6E56\u4F1A\u6620\u51FA\u4EBA\u5FC3\u91CC\u85CF\u7740\u7684\u4E8B\u3002\u6240\u4EE5\u4ECA\u5929\u4E0D\u8BB8\u9760\u5CB8\u592A\u8FD1\u3002"
    - Speaker: "\u5192\u9669\u5BB6"
      Portrait: {fileID: 0}
      Expression: 1
      Text: "\u4F60\u4E5F\u6709\u4E0D\u60F3\u8BA9\u6211\u770B\u89C1\u7684\u4E1C\u897F\uFF1F"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      Expression: 1
      Text: "\u5F53\u7136\u3002\u9B54\u5973\u8981\u662F\u4EC0\u4E48\u90FD\u8BA9\u4F60\u77E5\u9053\uFF0C\u4F60\u8FD8\u4F1A\u8FD9\u4E48\u597D\u5947\u5417\uFF1F"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      Expression: 11
      Text: "\u6E56\u8FB9\u5F88\u6ED1\u3002\u8981\u62C9\u4F4F\u6211\u7684\u624B\u5C31\u73B0\u5728\u2026\u2026\u522B\u8BEF\u4F1A\uFF0C\u6211\u53EA\u662F\u61D2\u5F97\u518D\u635E\u4F60\u4E00\u6B21\u3002"
    PortraitAtlasNames:
    - YayaExpressions
  - Id: chapter4
    Title: "\u7B2C\u56DB\u7AE0 \xB7 \u96FE\u91CC\u53EA\u8DDF\u7740\u6211"
    Portrait: {fileID: 0}
    BackgroundChapter: 4
    Lines:
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      Expression: 23
      Text: "\u6CBC\u6CFD\u91CC\u4F1A\u6709\u58F0\u97F3\u5B66\u6211\u8BF4\u8BDD\u3002\u5B83\u53EB\u4F60\u9760\u8FD1\uFF0C\u4F60\u5C31\u504F\u8981\u8FDC\u4E00\u70B9\u3002"
    - Speaker: "\u5192\u9669\u5BB6"
      Portrait: {fileID: 0}
      Expression: 1
      Text: "\u90A3\u6211\u600E\u4E48\u5206\u8FA8\u771F\u6B63\u7684\u9E26\u9E26\uFF1F"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      Expression: 13
      Text: "\u5047\u7684\u4F1A\u4E00\u76F4\u5938\u4F60\uFF0C\u771F\u7684\u4F1A\u8BF4\u4F60\u600E\u4E48\u53C8\u72AF\u50BB\u4E86\u3002\u8BB0\u4F4F\u4E86\u5417\uFF1F"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      Expression: 11
      Text: "\u8FD8\u6709\uFF0C\u771F\u7684\u4F1A\u4F38\u624B\u628A\u4F60\u62C9\u56DE\u6765\u3002\u6240\u4EE5\u8FD9\u6B21\uFF0C\u4E0D\u8BB8\u8D70\u4E22\u3002"
    PortraitAtlasNames:
    - YayaExpressions
  - Id: chapter5
    Title: "\u7B2C\u4E94\u7AE0 \xB7 \u51B0\u96EA\u4E0E\u501F\u53E3"
    Portrait: {fileID: 0}
    BackgroundChapter: 5
    Lines:
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      Expression: 3
      Text: "\u5BD2\u661F\u539F\u4F1A\u628A\u8FDC\u7A0B\u9635\u578B\u62C6\u5F97\u5F88\u96BE\u770B\u3002\u4FDD\u6301\u8FDE\u7ED3\uFF0C\u522B\u628A\u53D7\u4F24\u7684\u540C\u4F34\u7559\u5728\u5916\u9762\u3002"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      Expression: 11
      Text: "\u89C9\u5F97\u51B7\uFF1F\u4F60\u53EF\u4EE5\u7AD9\u8FD1\u4E00\u70B9\u3002\u6211\u8EAB\u8FB9\u7684\u62A4\u7B26\u80FD\u6321\u98CE\u3002"
    - Speaker: "\u5192\u9669\u5BB6"
      Portrait: {fileID: 0}
      Expression: 1
      Text: "\u53EA\u6321\u98CE\uFF1F\u6CA1\u6709\u522B\u7684\u529F\u80FD\u5417(\u60B2)"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      Expression: 13
      Text: "\u4E0D\u7136\u5462\uFF01\u4F60\u8FD8\u60F3\u8BA9\u9B54\u5973\u63D0\u4F9B\u4EC0\u4E48\u670D\u52A1\uFF1F\u2026\u2026\u62A4\u7B26\u5728\u6211\u5DE6\u8FB9\uFF0C\u4F60\u9760\u9519\u4E86\u3002"
    PortraitAtlasNames:
    - YayaExpressions
  - Id: chapter6
    Title: "\u7B2C\u516D\u7AE0 \xB7 \u5F52\u9014\u4E4B\u524D"
    Portrait: {fileID: 0}
    BackgroundChapter: 6
    Lines:
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      Expression: 3
      Text: "\u795E\u6BBF\u5C31\u5728\u773C\u524D\u3002\u6700\u540E\u4E00\u9875\u68CB\u8C31\uFF0C\u548C\u56DE\u53BB\u7684\u8DEF\uFF0C\u90FD\u5728\u90A3\u91CC\u3002"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      Expression: 23
      Text: "\u62FF\u5230\u4E4B\u540E\uFF0C\u4F60\u5927\u6982\u5C31\u4E0D\u7528\u7EE7\u7EED\u88AB\u6211\u5632\u8BBD\u4E86\uFF0C\u5F88\u9AD8\u5174\u5427\uFF1F"
    - Speaker: "\u5192\u9669\u5BB6"
      Portrait: {fileID: 0}
      Expression: 11
      Text: "\u6211\u53EF\u4EE5\u548C\u4F60\u4E00\u8D77\u8D70\u5417(\u60B2)"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      Expression: 12
      Text: "\u5C11\u62FF\u8FD9\u79CD\u8BDD\u6270\u4E71\u6211\u7684\u5224\u65AD\u3002\u5148\u8D62\u4E0B\u6765\uFF0C\u518D\u628A\u521A\u624D\u90A3\u53E5\u8BDD\u2026\u2026\u8BA4\u771F\u8BF4\u4E00\u6B21\u3002"
    PortraitAtlasNames:
    - YayaExpressions
  - Id: boss_after_1
    Title: "\u80DC\u540E \xB7 \u4E00\u70B9\u5229\u606F"
    Portrait: {fileID: 0}
    BackgroundChapter: 1
    Lines:
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      Expression: 3
      Text: "\u7B2C\u4E00\u5F20\u5230\u624B\u3002\u770B\u6765\u5192\u9669\u5BB6\u4E0D\u662F\u53EA\u4F1A\u5634\u786C\u3002"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      Expression: 1
      Text: "\u5956\u52B1\uFF1F\u5148\u8D4A\u8D26\u3002\u4F60\u60F3\u4EC0\u4E48\u65F6\u5019\u6765\u8BA8\uFF0C\u90FD\u53EF\u4EE5\u3002"
    PortraitAtlasNames:
    - YayaExpressions
  - Id: boss_after_2
    Title: "\u80DC\u540E \xB7 \u5979\u5728\u7B49\u4F60"
    Portrait: {fileID: 0}
    BackgroundChapter: 2
    Lines:
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      Expression: 23
      Text: "\u8336\u6CA1\u559D\uFF0C\u68CB\u8C31\u62FF\u5230\u4E86\u3002\u8FD8\u7B97\u77E5\u9053\u4EC0\u4E48\u8BE5\u5E26\u56DE\u6765\u3002"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      Expression: 11
      Text: "\u2026\u2026\u4EBA\u4E5F\u56DE\u6765\u4E86\u3002\u8FD9\u4E2A\u6BD4\u68CB\u8C31\u91CD\u8981\u4E00\u70B9\u3002\u53EA\u662F\u4E00\u70B9\u800C\u5DF2(\u5BB3\u7F9E)"
    PortraitAtlasNames:
    - YayaExpressions
  - Id: boss_after_3
    Title: "\u80DC\u540E \xB7 \u6E56\u6CA1\u6709\u56DE\u7B54"
    Portrait: {fileID: 0}
    BackgroundChapter: 3
    Lines:
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      Expression: 3
      Text: "\u7B2C\u4E09\u9875\u3002\u6E56\u91CC\u7684\u5012\u5F71\u6CA1\u770B\u6E05\uFF1F\u90A3\u5C31\u7EE7\u7EED\u731C\u3002"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      Expression: 1
      Text: "\u4E0D\u8FC7\uFF0C\u4F60\u731C\u6211\u7684\u5FC3\u601D\uFF0C\u6BD4\u731C\u4F60\u4E0B\u4E00\u6B65\u68CB\u8FD8\u8BA4\u771F\u5462\u3002"
    PortraitAtlasNames:
    - YayaExpressions
  - Id: boss_after_4
    Title: "\u80DC\u540E \xB7 \u88AB\u62C9\u4F4F\u7684\u624B"
    Portrait: {fileID: 0}
    BackgroundChapter: 4
    Lines:
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      Expression: 13
      Text: "\u8BF4\u4E86\u522B\u4E71\u8D70\u3002\u4F60\u4EE5\u4E3A\u6211\u6BCF\u6B21\u90FD\u80FD\u53CA\u65F6\u6293\u4F4F\u4F60\u5417\uFF1F"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      Expression: 11
      Text: "\u65E2\u7136\u6293\u5230\u4E86\uFF0C\u5C31\u5148\u522B\u677E\u5F00\u3002\u96FE\u8FD8\u6CA1\u6563\uFF0C\u8FD9\u662F\u5FC5\u8981\u63AA\u65BD\u3002"
    PortraitAtlasNames:
    - YayaExpressions
  - Id: boss_after_5
    Title: "\u80DC\u540E \xB7 \u878D\u96EA\u65F6\u5206"
    Portrait: {fileID: 0}
    BackgroundChapter: 5
    Lines:
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      Expression: 11
      Text: "\u7B2C\u4E94\u9875\u5230\u624B\uFF0C\u6696\u548C\u4E86\u6CA1\u6709\uFF1F\u4E0B\u4E00\u6B21\u53EF\u6CA1\u6709\u8FD9\u4E48\u73B0\u6210\u7684\u501F\u53E3\u3002"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      Expression: 13
      Text: "\u6211\u662F\u8BF4\u6321\u98CE\u7684\u501F\u53E3\uFF01\u2026\u2026\u4F60\u5230\u5E95\u5728\u60F3\u4EC0\u4E48\u3002"
    PortraitAtlasNames:
    - YayaExpressions
  - Id: boss_after_6
    Title: "\u80DC\u540E \xB7 \u9B54\u5973\u7684\u6761\u4EF6"
    Portrait: {fileID: 0}
    BackgroundChapter: 6
    Lines:
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      Expression: 11
      Text: "\u516D\u9875\u9F50\u4E86\u3002\u95E8\u771F\u7684\u4F1A\u6253\u5F00\u3002\u539F\u6765\u6211\u4E5F\u6709\u820D\u4E0D\u5F97\u6536\u8D26\u7684\u65F6\u5019\u3002"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      Expression: 1
      Text: "\u8D70\u4E4B\u524D\u7B54\u5E94\u6211\u4E00\u4EF6\u4E8B\u3002\u522B\u628A\u672C\u9E26\u7ED9\u5FD8\u4E86\uFF0C\u8BB0\u5F97\u5E38\u56DE\u6765\u770B\u770B"
    PortraitAtlasNames:
    - YayaExpressions
  - Id: ending
    Title: "\u5C3E\u58F0 \xB7 \u7EA6\u5B9A"
    Portrait: {fileID: 0}
    BackgroundChapter: 0
    Lines:
    - Speaker: "\u5192\u9669\u5BB6"
      Portrait: {fileID: 0}
      Expression: 3
      Text: "\u5982\u679C\u6211\u8FD8\u80FD\u56DE\u6765\uFF0C\u4F60\u4F1A\u8BA4\u51FA\u6211\u5417\uFF1F"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      Expression: 1
      Text: "\u4F60\u6B20\u4E86\u8FD9\u4E48\u591A\u836F\u6C34\u548C\u5938\u5956\uFF0C\u6211\u5F53\u7136\u8BA4\u5F97\u3002"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      Expression: 11
      Text: "\u5982\u679C\u4F60\u4E0D\u60F3\u8D70\u7684\u8BDD\uFF0C\u6211\u4E5F\u4F1A\u7ED9\u4F60\u7559\u4E00\u5F20\u5E8A\uFF0C\u81F3\u4E8E\u7761\u591A\u4E45\uFF0C\u4F60\u81EA\u5DF1\u51B3\u5B9A"
    - Speaker: "\u5192\u9669\u5BB6"
      Portrait: {fileID: 0}
      Expression: 23
      Text: "\u4F46\u6211\u8BB0\u5F97\u4F60\u5BB6\u597D\u50CF\u53EA\u6709\u4E00\u5F20\u5E8A\u5427\uFF0C\u5E73\u65F6\u6211\u90FD\u662F\u7761\u5730\u677F\u7684\u554A(\u60B2)"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      Expression: 13
      Text: "\u54FC\uFF0C\u81ED\u5192\u9669\u5BB6\uFF0C\u4ECA\u665A\u6211\u9976\u4E0D\u4E86\u4F60(\u6124\u6012)"
    - Speaker: "\u5192\u9669\u5BB6"
      Portrait: {fileID: 0}
      Expression: 23
      Text: "\u54CE\u54CE\u54CE\uFF0C\u6211\u8BF4\u9519\u4EC0\u4E48\u4E86\u5417\uFF0C\u4F60\u8981\u5E72\u561B\u554A\uFF0C\u5FEB\u70B9\u653E\u5F00\u6211\uFF0C\u4E0D\u662F\u8BF4\u8BA9\u6211\u56DE\u53BB\u5417(\u60B2)"
    PortraitAtlasNames:
    - YayaExpressions
