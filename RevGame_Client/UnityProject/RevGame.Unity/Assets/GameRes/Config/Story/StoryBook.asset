      Expression: 10
      Text: "\u996D\u6CA1\u5403\uFF0C\u68CB\u8C31\u62FF\u5230\u4E86\u3002\u8FD8\u7B97\u77E5\u9053\u4EC0\u4E48\u8BE5\u5E26\u56DE\u6765\u3002"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 11
      Text: "\u2026\u2026\u4EBA\u4E5F\u56DE\u6765\u4E86\u3002\u8FD9\u4E2A\u6BD4\u68CB\u8C31\u91CD\u8981\u4E00\u70B9\u3002\u53EA\u662F\u4E00\u70B9\u800C\u5DF2(\u5BB3\u7F9E)"
    PortraitAtlasNames:
    - YayaStoryOpening
  - Id: boss_after_3
    Title: "\u80DC\u540E \xB7 \u6E56\u6CA1\u6709\u56DE\u7B54"
    Portrait: {fileID: 0}
    PortraitReference:
      AssetGuid: 
      LocalId: 0
      SpriteName: 
      Atlas: 
    BackgroundChapter: 3
    Lines:
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 10
      Text: "\u7B2C\u4E09\u9875\u3002\u6E56\u91CC\u7684\u5012\u5F71\u6CA1\u770B\u6E05\uFF1F\u90A3\u5C31\u7EE7\u7EED\u731C\u3002"
    - Speaker: "\u5192\u9669\u5BB6"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 11
      Text: "\u6211\u600E\u4E48\u731C\u7684\u51FA\u6765\u4F60\u5230\u5E95\u6709\u4EC0\u4E48\u5FC3\u601D(\u60B2)"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 23
      Text: "\u54FC\uFF0C\u672C\u9E26\u7684\u5FC3\u601D\u8FD9\u4E48\u5355\u7EAF\u90FD\u770B\u4E0D\u51FA\u6765\uFF0C\u5192\u9669\u5BB6\u4ECA\u665A\u56DE\u53BB\u6211\u8981\u60E9\u7F5A\u4F60\uFF01(\u574F\u7B11)"
    - Speaker: "\u5192\u9669\u5BB6"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 23
      Text: "\u554A\uFF1F\u731C\u4E0D\u51FA\u6765\u90FD\u8981\u88AB\u60E9\u7F5A\u5427\uFF0C\u4F60\u8FD9\u6709\u70B9\u4E0D\u8BB2\u7406\u4E86\u554A\uFF0C\u6B3A\u8D1F\u6211\u6253\u4E0D\u8FC7\u4F60\u662F\u5427(\u60B2)"
    PortraitAtlasNames:
    - YayaExpressions
    - YayaStoryOpening
  - Id: boss_after_4
    Title: "\u80DC\u540E \xB7 \u88AB\u62C9\u4F4F\u7684\u624B"
    Portrait: {fileID: 0}
    PortraitReference:
      AssetGuid: 
      LocalId: 0
      SpriteName: 
      Atlas: 
    BackgroundChapter: 4
    Lines:
