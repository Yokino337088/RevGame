      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 23
      Text: "\u8BF4\u4E86\u522B\u4E71\u8D70\u3002\u4F60\u4EE5\u4E3A\u6211\u6BCF\u6B21\u90FD\u80FD\u53CA\u65F6\u6293\u4F4F\u4F60\u5417\uFF1F"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 11
      Text: "\u65E2\u7136\u6293\u5230\u4E86\uFF0C\u5C31\u5148\u522B\u677E\u5F00\u3002\u96FE\u8FD8\u6CA1\u6563\uFF0C\u8FD9\u662F\u5FC5\u8981\u63AA\u65BD\u3002"
    PortraitAtlasNames:
    - YayaExpressions
    - YayaStoryOpening
  - Id: boss_after_5
    Title: "\u80DC\u540E \xB7 \u878D\u96EA\u65F6\u5206"
    Portrait: {fileID: 0}
    PortraitReference:
      AssetGuid: 
      LocalId: 0
      SpriteName: 
      Atlas: 
    BackgroundChapter: 5
    Lines:
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 11
      Text: "\u7B2C\u4E94\u9875\u5230\u624B\uFF0C\u6696\u548C\u4E86\u6CA1\u6709\uFF1F\u4E0B\u4E00\u6B21\u53EF\u6CA1\u6709\u8FD9\u4E48\u73B0\u6210\u7684\u501F\u53E3\u3002"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 13
      Text: "\u6211\u662F\u8BF4\u6321\u98CE\u7684\u501F\u53E3\uFF01\u2026\u2026\u4F60\u5230\u5E95\u5728\u60F3\u4EC0\u4E48\u3002"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 11
      Text: "\u8FD8\u6709\uFF0C\u62A4\u80FD\u7B26\u662F\u6709\u51B7\u5374\u65F6\u95F4\u7684\uFF0C\u521A\u521A\u5DF2\u7ECF\u7528\u5B8C\u4E86\uFF0C\u73B0\u5728\u4F60\u8981\u8BA9\u672C\u9E26\u9760\u4E00\u4E0B\u53D6\u6696\u3002"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 13
      Text: "\u4F60\u8FD8\u7B11\uFF01\u672C\u9E26\u5C31\u662F\u89C9\u5F97\u6709\u70B9\u51B7\u800C\u5DF2\uFF0C\u9760\u4E00\u4E0B\u90FD\u4E0D\u884C\u5417(\u5BB3\u7F9E)"
    PortraitAtlasNames:
    - YayaExpressions
    - YayaStoryOpening
  - Id: boss_after_6
    Title: "\u80DC\u540E \xB7 \u53CD\u6094"
    Portrait: {fileID: 0}
    PortraitReference:
      AssetGuid: 
      LocalId: 0
      SpriteName: 
      Atlas: 
    BackgroundChapter: 6
    Lines:
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 23
      Text: "\u516D\u9875\u9F50\u4E86\u3002\u4F46\u662F\u6211\u5DF2\u7ECF\u53CD\u6094\u4E86\uFF0C\u4F60\u8FD8\u662F\u7559\u4E0B\u6765\u7ED9\u6211\u505A\u4E00\u8F88\u5B50\u5BB6\u52A1\u5427\uFF01"
    - Speaker: "\u5192\u9669\u5BB6"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 14
      Text: "\u554A\uFF0C\u4F60\u6765\u771F\u7684\u554A\uFF0C\u9E26\u9E26\u5927\u4EBA\uFF0C\u6C42\u4F60\u4E86\uFF0C\u653E\u6211\u8D70\u5427(\u60B2)"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 13
      Text: "\u665A\u4E86\uFF0C\u8C01\u8BA9\u4F60\u8FD9\u4E48\u8FDF\u949D(\u751F\u6C14)"
    PortraitAtlasNames:
    - YayaCombatExpressions
    - YayaExpressions
  - Id: ending
    Title: "\u5927\u7ED3\u5C40"
    Portrait: {fileID: 0}
    PortraitReference:
      AssetGuid: 
      LocalId: 0
      SpriteName: 
      Atlas: 
    BackgroundChapter: 0
    Lines:
    - Speaker: "\u5192\u9669\u5BB6"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 18
      Text: "\u54CE\uFF0C\u7559\u4E0B\u6765\u4E5F\u597D\uFF0C\u53CD\u6B63\u6211\u4E5F\u4E0D\u662F\u5F88\u60F3\u8D70(\u60B2)"
    - Speaker: "\u5192\u9669\u5BB6"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 17
      Text: "\u56DE\u53BB\u73B0\u5B9E\u4E16\u754C\u8FD8\u5F97\u7EE7\u7EED\u4E0A\u73ED\uFF0C\u5DE5\u8D44\u53C8\u4F4E\uFF0C\u8FD8\u4E0D\u5982\u7559\u4E0B\u6765\u5462(\u60B2)"
    - Speaker: "\u5192\u9669\u5BB6"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 11
      Text: "\u5728\u8FD9\u91CC\u53EA\u9700\u8981\u628A\u4F60\u8FD9\u4E2A\u7956\u5B97\u4F3A\u5019\u597D\u5C31\u884C\u4E86\uFF0C\u53CD\u6B63\u6709\u5403\u6709\u559D\uFF0C\u4E0D\u7528\u5DE5\u4F5C\uFF0C\u8FD8\u80FD\u591F\u5B66\u4E60\u9B54\u6CD5\uFF0C\u8FD9\u6CE2\u4E0D\u4E8F\u3002"
    - Speaker: "\u5192\u9669\u5BB6"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 10
      Text: "\u4F46\u662F\u6211\u6709\u4E00\u4E2A\u80FD\u4E0D\u80FD\u63D0\u4E00\u4E2A\u8981\u6C42\uFF0C\u6211\u90FD\u5E2E\u4F60\u96C6\u9F50\u516D\u9875\u68CB\u8C31\u4E86\uFF0C\u9E26\u9E26\u5927\u4EBA\u80FD\u4E0D\u80FD\u8BA9\u6211\u7761\u5E8A\u4E0A\u5462\uFF0C\u5730\u677F\u5B9E\u5728\u662F\u592A\u786C\u4E86\uFF0C\u6BCF\u5929\u6839\u672C\u5C31\u7761\u4E0D\u7740\u554A(\u60B2)"
    - Speaker: "\u5192\u9669\u5BB6"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 5
      Text: "\u53CD\u6B63\u4F60\u5BB6\u7684\u5E8A\u4E5F\u633A\u5927\u7684\uFF0C\u5927\u4E0D\u4E86\u6211\u4EEC\u9694\u5F00\u70B9\u7761\u5C31\u884C\u4E86(\u60B2)"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 11
      Text: "\u4F60\u56DE\u53BB\u628A\u6211\u4F3A\u5019\u597D\u7684\u8BDD\uFF0C\u672C\u9E26\u53EF\u4EE5\u8003\u8651\u4E00\u4E0B(\u574F\u7B11)"
    - Speaker: "\u5192\u9669\u5BB6"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 14
      Text: "\u611F\u8C22\u9E26\u9E26\u5927\u4EBA\u5927\u53D1\u6148\u60B2\uFF0C\u90A3\u6211\u53EF\u8981\u5148\u8D70\u4E86(\u574F\u7B11)"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 13
      Text: "\u7AD9\u4F4F\uFF0C\u4F60\u8981\u53BB\u54EA\u91CC\uFF1F\u8981\u63D0\u524D\u8DDF\u672C\u9E26\u62A5\u5907\u77E5\u9053\u5417\uFF01(\u751F\u6C14)"
    - Speaker: "\u5192\u9669\u5BB6"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 23
      Text: "\u5F53\u7136\u662F\u56DE\u5BB6\u554A\uFF0C\u8981\u4E0D\u8FD9\u6837\u5427\uFF0C\u6211\u4EEC\u6BD4\u6BD4\u8C01\u5148\u5230\u5BB6\u600E\u4E48\u6837\uFF0C\u8F93\u7684\u4EBA\u4ECA\u665A\u7761\u5730\u677F\u3002"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 13
      Text: "\u8BF6\uFF0C\u4F60\u600E\u4E48\u5148\u8DD1\u4E86\u554A\uFF0C\u7ED9\u6211\u7AD9\u4F4F\uFF0C\u81ED\u5192\u9669\u5BB6\u8981\u662F\u8BA9\u6211\u6293\u5230\u4F60\uFF0C\u4ECA\u665A\u53EF\u6709\u4F60\u597D\u53D7\u7684(\u751F\u6C14)"
    PortraitAtlasNames:
    - YayaCombatExpressions
    - YayaExpressions
    - YayaStoryJourney
    - YayaStoryOpening
