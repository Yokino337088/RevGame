  Episodes:
  - Id: opening
    Title: "\u5E8F\u7AE0 \xB7 \u88AB\u9E26\u9E26\u6361\u8D70\u7684\u5192\u9669\u5BB6"
    Portrait: {fileID: 0}
    PortraitReference:
      AssetGuid: 
      LocalId: 0
      SpriteName: 
      Atlas: 
    BackgroundChapter: 0
    Lines:
    - Speaker: "\u5192\u9669\u5BB6"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 19
      Text: "\u554A\u554A\u554A\u554A\u554A\u554A\u554A\u554A\u554A\u554A\u554A\u554A\u554A\uFF0C\u5230\u5E95\u600E\u4E48\u56DE\u4E8B\u554A\uFF0C\u6211\u96BE\u9053\u7A7F\u8D8A\u4E86\u5417"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 18
      Text: "\u8BF6\uFF0C\u8FD9\u662F\u4EBA\u7C7B\u5417\uFF0C\u8FD9\u5C0F\u4F19\u770B\u8D77\u6765\u8FD8\u633A\u5E05\u7684\u5417"
    - Speaker: "\u5192\u9669\u5BB6"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 1
      Text: "\u4F60\u662F\u8C01\u554A\uFF0C\u8FD8\u6709\u6211\u4E3A\u4EC0\u4E48\u4F1A\u51FA\u73B0\u5728\u8FD9\u91CC\uFF0C\u6211\u521A\u521A\u8FD8\u5728\u5BB6\u5462"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 10
      Text: "\u6211\u600E\u4E48\u77E5\u9053\u4F60\u7A81\u7136\u4F1A\u51FA\u73B0\u5728\u8FD9\u91CC\uFF0C\u8FD8\u6709\u6211\u7684\u540D\u5B57\u53EB\u9E26\u9E26\uFF0C\u6211\u53EF\u4E0D\u559C\u6B22\u88AB\u522B\u4EBA\u53EB\u6210\u201C\u90A3\u4E2A\u5973\u7684\u201D"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 11
      Text: "\u8FD9\u4E48\u76F4\u52FE\u52FE\u5730\u770B\u7740\u6211\u505A\u4EC0\u4E48\uFF1F\u6CA1\u89C1\u8FC7\u7F8E\u5973\u5417"
    - Speaker: "\u5192\u9669\u5BB6"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 23
      Text: "\u5207\uFF0C\u8C01\u7A00\u7F55\u4F60\u554A(\u60B2)"
    - Speaker: "\u5192\u9669\u5BB6"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 10
      Text: "\u6240\u4EE5\u4F60\u53EF\u4EE5\u544A\u8BC9\u6211\u8FD9\u91CC\u662F\u4EC0\u4E48\u5730\u65B9\u5417"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 17
      Text: "\u8FD9\u91CC\u561B\uFF0C\u662F\u5F08\u9646\u5927\u9646\uFF0C\u4E0D\u8FC7\u7A81\u7136\u6709\u4E00\u4E2A\u4EBA\u7C7B\u51FA\u73B0\u5728\u8FD9\u91CC\u8FD8\u662F\u633A\u7A00\u5947\u7684\u5462\uFF0C\u4F60\u53EF\u662F\u6765\u5230\u6211\u4EEC\u4E16\u754C\u7684\u7B2C\u4E00\u4E2A\u4EBA\u7C7B\u54E6\uFF0C\u90A3\u5C31\u6682\u4E14\u53EB\u4F60\u201C\u5192\u9669\u5BB6\u5427\u201D"
    - Speaker: "\u5192\u9669\u5BB6"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 10
      Text: "\u90A3\u6211\u8981\u600E\u4E48\u529E\u624D\u80FD\u56DE\u5230\u6211\u539F\u6765\u7684\u4E16\u754C\u5462"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 3
      Text: "\u8FD9\u4E2A\u561B\uFF0C\u6211\u5230\u6709\u4E2A\u529E\u6CD5\uFF0C\u53EA\u8981\u4F60\u966A\u6211\u627E\u9F50\u516D\u9875\u5931\u6563\u7684\u68CB\u8C31\uFF0C\u6211\u5C31\u4F1A\u5E26\u4F60\u56DE\u5230\u539F\u6765\u7684\u4E16\u754C"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 1
      Text: "\u4F60\u8D1F\u8D23\u6218\u6597\uFF0C\u6211\u8D1F\u8D23\u5F53\u7763\u6218\u961F\u76D1\u7763\u4F60\uFF0C\u8981\u662F\u4F60\u4E0D\u60F3\u6765\u7684\u8BDD\uFF0C\u4E5F\u53EF\u4EE5\u7559\u4E0B\u6765\u7ED9\u6211\u505A\u5BB6\u52A1"
    - Speaker: "\u5192\u9669\u5BB6"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 23
      Text: "\u6211\u6709\u7684\u9009\u5417(\u60B2)"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 10
      Text: "\u60F3\u597D\u4E86\u5417\uFF0C\u5192\u9669\u5BB6\uFF0C\u4F60\u662F\u8981\u7ED9\u6211\u5F53\u4E00\u8F88\u5B50\u7684\u5BB6\u653F\u5458\u5DE5\u8FD8\u662F\u8D76\u7D27\u96C6\u9F50\u516D\u9875\u5931\u6563\u7684\u68CB\u8C31\u5462"
    PortraitAtlasNames:
    - YayaExpressions
    - YayaStoryOpening
  - Id: tutorial
    Title: "\u7B2C\u4E00\u8BFE \xB7 \u522B\u8BA9\u6211\u767D\u6551\u4F60"
    Portrait: {fileID: 0}
    PortraitReference:
      AssetGuid: 
      LocalId: 0
      SpriteName: 
      Atlas: 
    BackgroundChapter: 0
    Lines:
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 3
      Text: "\u68CB\u5B50\u4F1A\u81EA\u5DF1\u6218\u6597\uFF0C\u4F60\u8981\u505A\u7684\u662F\u628A\u540C\u4F34\u6446\u5230\u5408\u9002\u7684\u4F4D\u7F6E\u3002\u4E0D\u662F\u628A\u4ED6\u4EEC\u968F\u4FBF\u5806\u5728\u4E00\u8D77\u61C2\u5417"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 1
      Text: "\u8FDE\u7ED3\u3001\u7559\u773C\u3001\u5C01\u6C14\u3001\u6362\u4F4D\u3002\u542C\u4E0D\u61C2\u4E5F\u6CA1\u5173\u7CFB\uFF0C\u6211\u4F1A\u5728\u65C1\u8FB9\u76D1\u7763\u4F60"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 23
      Text: "\u6253\u8D62\u4E86\u6CA1\u5956\u52B1\uFF0C\u6253\u8F93\u4E86\u6709\u60E9\u7F5A"
    - Speaker: "\u5192\u9669\u5BB6"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 11
      Text: "\u4EC0\u4E48\u60E9\u7F5A\uFF1F(\u60B2)"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 2
      Text: "\u7B49\u4E00\u4E0B\u4F60\u5C31\u77E5\u9053\u4E86(\u574F\u7B11)"
    PortraitAtlasNames:
    - YayaCombatExpressions
    - YayaExpressions
    - YayaStoryOpening
  - Id: lesson
    Title: "\u9E26\u9E26\u7684\u5B9E\u6218\u63D0\u9192"
    Portrait: {fileID: 0}
    PortraitReference:
      AssetGuid: 
      LocalId: 0
      SpriteName: 
      Atlas: 
    BackgroundChapter: 1
    Lines:
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 10
      Text: "\u5148\u9009\u5DE6\u4FA7\u9B54\u6CD5\u6846\u4E2D\u7684\u5251\u58EB\u624B\u724C\u3002\u770B\u68CB\u76D8\uFF0C\u522B\u603B\u770B\u6211\u3002"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 1
      Text: "\u654C\u4EBA\u53EA\u5269\u4E0B\u65B9\u90A3\u4E00\u53E3\u6C14\u3002\u628A\u68CB\u5B50\u653E\u5230\u9AD8\u4EAE\u7A7A\u683C\uFF0C\u8BD5\u8BD5\u8BA9\u5B83\u65E0\u8DEF\u53EF\u8D70\u3002"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 18
      Text: "\u96F6\u6C14\u9650\u5236\u884C\u52A8\uFF0C\u53EF\u4E0D\u662F\u4E00\u53E5\u5492\u8BED\u5C31\u628A\u751F\u547D\u6263\u5149\u3002\u73B0\u5728\u9009\u4E2D\u5DE6\u8FB9\u7684\u5DF1\u65B9\u68CB\u5B50\u3002"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 10
      Text: "\u79FB\u5230\u5DE6\u4FA7\u9AD8\u4EAE\u7A7A\u683C\u3002\u770B\u5230\u4E86\u5417\uFF1F\u4F60\u8BA9\u51FA\u4F4D\u7F6E\uFF0C\u5B83\u5C31\u6062\u590D\u4E86\u4E00\u53E3\u6C14\u3002\u6BCF\u4E00\u6B65\u90FD\u8981\u60F3\u6E05\u695A\u3002"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 11
      Text: "\u505A\u5F97\u4E0D\u9519\u3002\u522B\u7B11\u90A3\u4E48\u5F97\u610F\u2026\u2026\u6211\u53EA\u5938\u8FD9\u4E00\u6B21\u3002\u7B49\u51C6\u5907\u589E\u76CA\u62B5\u8FBE\uFF0C\u518D\u70B9\u5F00\u59CB\u6218\u6597\u3002"
    PortraitAtlasNames:
    - YayaExpressions
    - YayaStoryOpening
  - Id: pvp_tutorial_intro
    Title: "\u4E5D\u8DEF\u56F4\u68CB \xB7 \u7B2C\u4E00\u9897\u68CB"
    Portrait: {fileID: 0}
    PortraitReference:
      AssetGuid: 
      LocalId: 0
      SpriteName: 
      Atlas: 
    BackgroundChapter: -1
    Lines:
    - Speaker: "\u5192\u9669\u5BB6"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 18
      Text: "\u8FD9\u5C31\u662F\u4E5D\u8DEF\u56F4\u68CB\uFF1F\u68CB\u5B50\u4E5F\u80FD\u62FF\u6765\u6253\u67B6\u5417\uFF1F"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 10
      Text: "\u5148\u628A\u6253\u67B6\u90A3\u4E00\u5957\u6536\u8D77\u6765\u3002\u8FD9\u91CC\u9760\u843D\u5B50\u3001\u63D0\u5B50\u548C\u56F4\u5730\u5206\u80DC\u8D1F\uFF0C\u672C\u9E26\u5E26\u4F60\u8D70\u4E00\u904D\u3002"
    - Speaker: "\u5192\u9669\u5BB6"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 11
      Text: "\u90A3\u6211\u628A\u9ED1\u68CB\u653E\u8FDB\u683C\u5B50\u91CC\uFF0C\u8D70\u9519\u4E86\u518D\u632A\u4E00\u683C\uFF1F"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 1
      Text: "\u4E0B\u5728\u4E24\u6761\u7EBF\u7684\u4EA4\u53C9\u70B9\u3002\u9ED1\u68CB\u5148\u4E0B\uFF0C\u843D\u5B9A\u5C31\u4E0D\u80FD\u632A\u4E86\u3002\u5F85\u4F1A\u513F\u770B\u597D\u4EAE\u8D77\u6765\u7684\u70B9\u3002"
    - Speaker: "\u5192\u9669\u5BB6"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 18
      Text: "\u597D\uFF0C\u6211\u5148\u4E0B\u4E00\u9897\u3002\u8D70\u9519\u4E86\u4F60\u53EF\u5F97\u63D0\u9192\u6211\u3002"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 3
      Text: "\u90A3\u5C31\u4ECE\u7B2C\u4E00\u9897\u5F00\u59CB\u3002\u770B\u68CB\u76D8\uFF0C\u522B\u603B\u770B\u6211\u3002"
    PortraitAtlasNames:
    - YayaExpressions
    - YayaStoryOpening
  - Id: pvp_tutorial_outro
    Title: "\u4E5D\u8DEF\u56F4\u68CB \xB7 \u4E0B\u4E00\u5C40\u89C1"
    Portrait: {fileID: 0}
    PortraitReference:
      AssetGuid: 
      LocalId: 0
      SpriteName: 
      Atlas: 
    BackgroundChapter: -1
    Lines:
    - Speaker: "\u5192\u9669\u5BB6"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 18
      Text: "\u5341\u4E94\u8BFE\u8D70\u5B8C\u4E86\u3002\u539F\u6765\u68CB\u5B50\u8FD9\u4E48\u5C0F\uFF0C\u8BB2\u7A76\u5012\u633A\u591A\u3002"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 3
      Text: "\u90A3\u672C\u9E26\u8003\u4F60\u3002\u53CC\u65B9\u90FD\u505C\u4E00\u624B\uFF0C\u63A5\u4E0B\u6765\u505A\u4EC0\u4E48\uFF1F"
    - Speaker: "\u5192\u9669\u5BB6"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 1
      Text: "\u5148\u6807\u6B7B\u5B50\uFF0C\u53CC\u65B9\u786E\u8BA4\u540E\u518D\u7B97\u5206\u3002\u7B54\u5BF9\u4E86\u5427\uFF1F"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 10
      Text: "\u5BF9\u3002\u771F\u4E0B\u68CB\u65F6\u4E5F\u5148\u770B\u6C14\uFF0C\u60F3\u597D\u4E86\u518D\u843D\u5B50\u3002"
    - Speaker: "\u5192\u9669\u5BB6"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 23
      Text: "\u61C2\u4E86\u3002\u6211\u53BB\u627E\u4E2A\u68CB\u53CB\uFF0C\u8BA4\u8BA4\u771F\u771F\u4E0B\u4E00\u5C40\u3002"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 18
      Text: "\u53BB\u5427\u3002\u8F93\u4E86\u5C31\u5E26\u68CB\u8C31\u56DE\u6765\uFF0C\u672C\u9E26\u966A\u4F60\u770B\u3002"
    PortraitAtlasNames:
    - YayaExpressions
    - YayaStoryOpening
  - Id: chapter1
    Title: "\u7B2C\u4E00\u7AE0 \xB7 \u661F\u843D\u5C0F\u5F84"
    Portrait: {fileID: 0}
    PortraitReference:
      AssetGuid: 
      LocalId: 0
      SpriteName: 
      Atlas: 
    BackgroundChapter: 1
    Lines:
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 14
      Text: "\u524D\u9762\u662F\u661F\u843D\u5C0F\u5F84\u3002\u7B2C\u4E00\u5F20\u68CB\u8C31\u5728\u5C3D\u5934\uFF0C\u6CBF\u8DEF\u7684\u5BB6\u4F19\u4F1A\u7528\u5B9E\u529B\u8DDF\u4F60\u6253\u62DB\u547C\u3002"
    - Speaker: "\u5192\u9669\u5BB6"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 10
      Text: "\u8FD9\u662F\u8981\u5F00\u59CB\u6218\u6597\u4E86\u5417\uFF1F(\u60B2)"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 23
      Text: "\u8D76\u7D27\u7684\uFF0C\u522B\u8FD9\u4E48\u78E8\u8E6D\uFF0C\u4F60\u5148\u4E0A\uFF0C\u6211\u5728\u80CC\u540E\u76D1\u7763\u4F60\u3002"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 20
      Text: "\u8981\u662F\u4F60\u8D62\u4E86\u561B\uFF0C\u6211\u53EF\u4EE5\u8003\u8651\u7ED9\u4F60\u4E00\u70B9\u5C0F\u5C0F\u7684\u5956\u52B1"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 23
      Text: "\u4F46\u662F\u5982\u679C\u4F60\u8FDE\u8FD9\u4E48\u7B80\u5355\u7684\u8BD5\u70BC\u90FD\u65E0\u6CD5\u901A\u8FC7\u7684\u8BDD\uFF0C\u90A3\u4F60\u5C31\u53EA\u80FD\u56DE\u53BB\u7ED9\u6211\u5F53\u4E00\u4E2A\u6708\u7684\u811A\u57AB\u4E86"
    - Speaker: "\u5192\u9669\u5BB6"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 5
      Text: "(\u60B2)"
    PortraitAtlasNames:
    - YayaCombatExpressions
    - YayaExpressions
    - YayaStoryJourney
    - YayaStoryOpening
  - Id: chapter2
    Title: "\u7B2C\u4E8C\u7AE0 \xB7 \u9752\u85E4\u6751"
    Portrait: {fileID: 0}
    PortraitReference:
      AssetGuid: 
      LocalId: 0
      SpriteName: 
      Atlas: 
    BackgroundChapter: 2
    Lines:
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 3
      Text: "\u8D70\u8FC7\u4E86\u661F\u843D\u5C0F\u5F84\uFF0C\u7B2C\u4E8C\u5173\u8BD5\u70BC\u5C31\u5230\u4E86\u9752\u85E4\u6751\u3002"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 3
      Text: "\u9752\u85E4\u6751\u7684\u5C45\u6C11\u5F88\u70ED\u60C5\uFF0C\u70ED\u60C5\u5230\u4F1A\u628A\u51B3\u6597\u5F53\u4F5C\u62DB\u5F85\u3002\u5148\u770B\u654C\u9635\uFF0C\u518D\u4E0B\u7B2C\u4E00\u9897\u68CB\u3002"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 23
      Text: "\u5982\u679C\u6709\u4EBA\u8BF7\u4F60\u7559\u4E0B\u5403\u996D\u7684\u8BDD\uFF0C\u4F60\u6700\u597D\u60F3\u60F3\u8C01\u8FD8\u5728\u7B49\u4F60\u3002"
    - Speaker: "\u5192\u9669\u5BB6"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 23
      Text: "\u4F60\u4E0D\u662F\u8BF4\u4E0D\u62C5\u5FC3\u6211\u5417\uFF1F"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 13
      Text: "\u54FC\uFF01\u6211\u62C5\u5FC3\u7684\u662F\u5BB6\u52A1\u6CA1\u4EBA\u505A\uFF01\u2026\u2026\u4F60\u7B11\u591F\u4E86\u6CA1\u6709\uFF1F\u8D70\u4E86\u3002"
    PortraitAtlasNames:
    - YayaExpressions
  - Id: chapter3
    Title: "\u7B2C\u4E09\u7AE0 \xB7 \u955C\u6E56"
    Portrait: {fileID: 0}
    PortraitReference:
      AssetGuid: 
      LocalId: 0
      SpriteName: 
      Atlas: 
    BackgroundChapter: 3
    Lines:
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 11
      Text: "\u955C\u6E56\u4F1A\u6620\u51FA\u4EBA\u5FC3\u91CC\u85CF\u7740\u7684\u4E8B\u3002\u6240\u4EE5\u4ECA\u5929\u4E0D\u8BB8\u9760\u5CB8\u592A\u8FD1\u3002"
    - Speaker: "\u5192\u9669\u5BB6"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 14
      Text: "\u6211\u65E0\u6240\u8C13\uFF0C\u4F46\u662F\u4F60\u4E00\u4E2A\u9B54\u5973\u6574\u5929\u9664\u4E86\u4FEE\u70BC\u5C31\u6CA1\u522B\u7684\u4E86\uFF0C\u80FD\u6709\u4EC0\u4E48\u5FC3\u4E8B\uFF1F(\u60B2)"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 23
      Text: "\u54FC\uFF0C\u672C\u9E26\u6709\u4EC0\u4E48\u4E8B\u7528\u5F97\u7740\u4F60\u7BA1\u5417\uFF01"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 11
      Text: "\u6E56\u8FB9\u5F88\u6ED1\u3002\u8981\u662F\u4E0D\u60F3\u6389\u4E0B\u53BB\u5C31\u6293\u7D27\u6211\u7684\u624B"
    - Speaker: "\u5192\u9669\u5BB6"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 11
      Text: "\u770B\u6765\u4F60\u8FD8\u633A\u5728\u610F\u6211\u7684\u561B\uFF0C\u4F60\u4E4B\u524D\u4E0D\u662F\u8BF4\u8FC7\u4E0D\u7BA1\u6211\u4E86\u5417\uFF1F"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 13
      Text: "\u4F60\u7B11\u4EC0\u4E48\uFF0C\u6211\u53EA\u662F\u61D2\u5F97\u635E\u4F60\u800C\u5DF2\uFF01"
    PortraitAtlasNames:
    - YayaCombatExpressions
    - YayaExpressions
    - YayaStoryOpening
  - Id: chapter4
    Title: "\u7B2C\u56DB\u7AE0 \xB7 \u8FF7\u96FE\u6CBC\u6CFD"
    Portrait: {fileID: 0}
    PortraitReference:
      AssetGuid: 
      LocalId: 0
      SpriteName: 
      Atlas: 
    BackgroundChapter: 4
    Lines:
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 23
      Text: "\u5C0F\u5FC3\u70B9\uFF0C\u8FD9\u91CC\u53EF\u662F\u6CBC\u6CFD\uFF0C\u548C\u955C\u6E56\u4E0D\u4E00\u6837\uFF0C\u8981\u662F\u6389\u4E0B\u53BB\u7684\u8BDD\u4F60\u5C31\u5B8C\u86CB\u4E86\uFF01"
    - Speaker: "\u5192\u9669\u5BB6"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 24
      Text: "\u771F\u6709\u8FD9\u4E48\u4E25\u91CD\u5417"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 23
      Text: "\u5FEB\u70B9\u6293\u7D27\u6211\u7684\u624B\uFF0C\u53EF\u522B\u6389\u4E0B\u53BB\u4E86\uFF0C\u4F60\u8981\u662F\u6389\u4E0B\u53BB\u7684\u8BDD\uFF0C\u6211\u53EF\u6551\u4E0D\u4E86\u4F60"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 23
      Text: "\u6CBC\u6CFD\u91CC\u9762\u7684\u654C\u4EBA\u4F1A\u6BD4\u955C\u6E56\u91CC\u9762\u7684\u654C\u4EBA\u66F4\u5389\u5BB3\uFF0C\u4E0D\u8981\u8F7B\u654C\u3002"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 2
      Text: "\u8D62\u4E86\u6CA1\u5956\u52B1\uFF0C\u8F93\u6389\u6709\u60E9\u7F5A(\u574F\u7B11)"
    - Speaker: "\u5192\u9669\u5BB6"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 14
      Text: "\u4E0D\u662F\u5427\uFF0C\u53C8\u6765\uFF1F\u4E0A\u6B21\u6211\u5DF2\u7ECF\u7ED9\u4F60\u5F53\u4E86\u4E00\u4E2A\u6708\u7684\u811A\u57AB\u4E86\uFF0C\u8FD9\u6B21\u5C31\u653E\u8FC7\u6211\u5427(\u60B2)"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 23
      Text: "\u4F60\u53EF\u6CA1\u5F97\u9009\uFF0C\u7ED9\u672C\u9E26\u632F\u4F5C\u8D77\u6765\uFF0C\u8981\u662F\u8F93\u4E86\u7684\u8BDD\uFF0C\u56DE\u53BB\u6211\u5C31\u8981\u62FF\u4F60\u6765\u505A\u70B9\u5C0F\u5B9E\u9A8C\u4E86(\u574F\u7B11)"
    - Speaker: "\u5192\u9669\u5BB6"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 2
      Text: "\u597D\u597D\u597D\uFF0C\u6211\u8BA4\u4E86\uFF0C\u6211\u53EF\u6253\u4E0D\u8FC7\u4F60(\u60B2)"
    PortraitAtlasNames:
    - YayaCombatExpressions
    - YayaExpressions
    - YayaStoryJourney
