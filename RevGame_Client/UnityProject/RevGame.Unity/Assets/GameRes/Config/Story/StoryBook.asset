  Guide: {fileID: 21300000, guid: 86628c30880b92340bebb59b484940af, type: 3}
  GuideFrames:
  - {fileID: 21300000, guid: 86628c30880b92340bebb59b484940af, type: 3}
  - {fileID: 21300000, guid: bdc30cd343a264e428ea46490ad491c6, type: 3}
  - {fileID: 21300000, guid: 5643a4082aa20554b942205bf2c30243, type: 3}
  TutorialRevision: 3
  CharactersPerSecond: 28
  Episodes:
  - Id: opening
    Title: "\u53F2\u83B1\u59C6\u68CB\u65C5 \xB7 \u843D\u5B50\u5F02\u4E16\u754C"
    Lines:
    - Speaker: "\u5192\u9669\u5BB6"
      Text: "\u6211\u672C\u6765\u53EA\u662F\u60F3\u627E\u4E2A\u5730\u65B9\u8EB2\u96E8\u3002\u53E4\u9057\u8FF9\u91CC\uFF0C\u90A3\u679A\u6E29\u70ED\u7684\u68CB\u5B50\u5374\u81EA\u5DF1\u8DF3\u8FDB\u4E86\u638C\u5FC3\u3002"
    - Speaker: "\u65C1\u767D"
      Text: "\u9ED1\u767D\u5149\u8292\u4E00\u95EA\uFF0C\u811A\u4E0B\u7684\u77F3\u9636\u5316\u6210\u68CB\u76D8\u3002\u518D\u7741\u773C\u65F6\uFF0C\u4E00\u56E2\u8F6F\u4E4E\u4E4E\u7684\u5C0F\u5BB6\u4F19\u6B63\u6233\u7740\u4F60\u7684\u9774\u5B50\u3002"
    - Speaker: "\u56E2\u56E2"
      Text: "\u9192\u5566\uFF01\u6B22\u8FCE\u6765\u5230\u5F08\u9732\u5927\u9646\uFF01\u6211\u662F\u56E2\u56E2\u2014\u2014\u8FD9\u91CC\u6700\u4F1A\u5E26\u8DEF\u3001\u6682\u65F6\u8FD8\u4E0D\u592A\u4F1A\u8D62\u68CB\u7684\u53F2\u83B1\u59C6\u3002"
    - Speaker: "\u5192\u9669\u5BB6"
      Text: "\u6240\u4EE5\u2026\u2026\u4F60\u4EEC\u89E3\u51B3\u95EE\u9898\u7684\u65B9\u5F0F\uFF0C\u662F\u4E0B\u56F4\u68CB\uFF1F"
    - Speaker: "\u56E2\u56E2"
      Text: "\u5F53\u7136\uFF01\u6211\u4EEC\u7528\u843D\u5B50\u4FEE\u6865\uFF0C\u7528\u8FDE\u7ED3\u4EA4\u670B\u53CB\u3002\u53EF\u795E\u6BBF\u7684\u5B88\u8C31\u8005\u628A\u68CB\u8C31\u6495\u6210\u4E86\u516D\u9875\uFF0C\u8FDE\u5927\u5730\u7684\u201C\u6C14\u201D\u90FD\u5F00\u59CB\u5835\u585E\u3002"
    - Speaker: "\u56E2\u56E2"
      Text: "\u4F60\u624B\u91CC\u7684\u661F\u843D\u68CB\u5B50\u80FD\u542C\u61C2\u540C\u4F34\u7684\u5FC3\u58F0\u3002\u966A\u6211\u627E\u56DE\u68CB\u8C31\u5427\uFF01\u8D70\u5B8C\u8FD9\u6761\u68CB\u8DEF\uFF0C\u4E5F\u8BB8\u5C31\u80FD\u6253\u5F00\u56DE\u5BB6\u7684\u95E8\u3002"
  - Id: tutorial
    Title: "\u51FA\u53D1\u4E4B\u524D \xB7 \u56E2\u56E2\u7684\u4E00\u5C0F\u5C40"
    Lines:
    - Speaker: "\u56E2\u56E2"
      Text: "\u5192\u9669\u5BB6\u4E0D\u7528\u5148\u80CC\u4E0B\u4E00\u6574\u672C\u68CB\u8C31\u3002\u6765\u661F\u843D\u68CB\u576A\uFF0C\u6211\u966A\u4F60\u7EC3\u4E00\u6B21\u843D\u5B50\u548C\u6362\u4F4D\u3002"
    - Speaker: "\u56E2\u56E2"
      Text: "\u8BB0\u4F4F\uFF1A\u8EAB\u8FB9\u76F8\u90BB\u7684\u7A7A\u4F4D\u5C31\u662F\u201C\u6C14\u201D\u3002\u5835\u4F4F\u5BF9\u624B\u7684\u6C14\u80FD\u9650\u5236\u884C\u52A8\uFF0C\u4F46\u8FD9\u91CC\u7684\u68CB\u5B50\u8FD8\u6709\u751F\u547D\uFF0C\u8981\u9760\u540C\u4F34\u4E00\u8D77\u8D62\u4E0B\u6218\u6597\u3002"
  - Id: chapter1
    Title: "\u7B2C\u4E00\u7AE0 \xB7 \u661F\u843D\u521D\u9022"
    Lines:
    - Speaker: "\u56E2\u56E2"
      Text: "\u8FD9\u7247\u68CB\u576A\u539F\u672C\u662F\u65B0\u670B\u53CB\u76F8\u8BC6\u7684\u5730\u65B9\uFF0C\u5982\u4ECA\u5DE1\u8DEF\u53F2\u83B1\u59C6\u5374\u628A\u6BCF\u4E2A\u8FC7\u5BA2\u90FD\u5F53\u6210\u6311\u6218\u8005\u3002"
    - Speaker: "\u56E2\u56E2"
      Text: "\u5148\u8BA9\u540C\u4F34\u8FDE\u5728\u4E00\u8D77\uFF0C\u518D\u627E\u5BF9\u9762\u7684\u7A7A\u9699\u3002\u72EC\u81EA\u901E\u5F3A\u4F1A\u65AD\u6C14\uFF0C\u5F7C\u6B64\u7167\u5E94\u624D\u80FD\u8D70\u8FDC\u3002"
    - Speaker: "\u5192\u9669\u5BB6"
      Text: "\u90A3\u5C31\u4ECE\u8FD9\u4E00\u624B\u5F00\u59CB\u3002\u6211\u4EEC\u8981\u8D62\uFF0C\u4E5F\u8981\u5F04\u6E05\u5B83\u4EEC\u4E3A\u4EC0\u4E48\u4E0D\u518D\u4FE1\u4EFB\u522B\u4EBA\u3002"
  - Id: chapter2
    Title: "\u7B2C\u4E8C\u7AE0 \xB7 \u4F1A\u547C\u5438\u7684\u9B54\u6CD5\u6751"
    Lines:
    - Speaker: "\u56E2\u56E2"
      Text: "\u770B\uFF01\u5C4B\u9876\u7684\u9B54\u6CD5\u706F\u53C8\u4EAE\u4E86\u3002\u7B2C\u4E00\u5F20\u68CB\u8C31\u5199\u7684\u4E0D\u662F\u62DB\u5F0F\uFF0C\u800C\u662F\u201C\u8FDE\u7ED3\u201D\u3002"
    - Speaker: "\u6751\u957F"
      Text: "\u5B88\u8C31\u8005\u66FE\u4FDD\u62A4\u6211\u4EEC\u3002\u53EF\u5B83\u8D8A\u6765\u8D8A\u5BB3\u6015\u5931\u53BB\uFF0C\u4FBF\u60F3\u628A\u6BCF\u4E2A\u9009\u62E9\u90FD\u56FA\u5B9A\u5728\u68CB\u76D8\u4E0A\u3002\u6751\u53E3\u7684\u5B88\u536B\uFF0C\u4E5F\u53EA\u80AF\u670D\u4ECE\u6700\u7A33\u7684\u9635\u5F62\u3002"
    - Speaker: "\u5192\u9669\u5BB6"
      Text: "\u6CA1\u6709\u53D8\u5316\u7684\u68CB\u5C40\uFF0C\u5C31\u6CA1\u6709\u65B0\u670B\u53CB\u3002\u56E2\u56E2\uFF0C\u501F\u7740\u540C\u4F34\u7684\u529B\u91CF\uFF0C\u6211\u4EEC\u4E00\u8D77\u6253\u5F00\u6751\u95E8\u3002"
  - Id: chapter3
    Title: "\u7B2C\u4E09\u7AE0 \xB7 \u955C\u6E56\u501F\u52BF"
    Lines:
    - Speaker: "\u56E2\u56E2"
      Text: "\u955C\u6E56\u4F1A\u6620\u51FA\u4F60\u6700\u60F3\u8D70\u7684\u90A3\u4E00\u6B65\u3002\u53EF\u5012\u5F71\u91CC\u7684\u6377\u5F84\uFF0C\u6709\u65F6\u6B63\u662F\u5BF9\u624B\u7B49\u7740\u7684\u9677\u9631\u3002"
    - Speaker: "\u5192\u9669\u5BB6"
      Text: "\u5982\u679C\u6BCF\u4E00\u5904\u90FD\u8981\u4E89\uFF0C\u6211\u4EEC\u5C31\u4F1A\u5904\u5904\u987E\u4E0D\u8FC7\u6765\u3002\u8BA9\u8FDC\u7A0B\u540C\u4F34\u7AD9\u7A33\uFF0C\u524D\u6392\u66FF\u5B83\u4EEC\u6321\u4F4F\u6765\u8DEF\u3002"
    - Speaker: "\u56E2\u56E2"
      Text: "\u61C2\u5566\uFF01\u7B2C\u4E8C\u5F20\u68CB\u8C31\u8BF4\u201C\u501F\u52BF\u201D\uFF1A\u4E0D\u662F\u6BCF\u9897\u68CB\u5B50\u90FD\u51B2\u5728\u524D\u9762\uFF0C\u624D\u80FD\u8D62\u5F97\u66F4\u8FDC\u7684\u5730\u65B9\u3002"
  - Id: chapter4
    Title: "\u7B2C\u56DB\u7AE0 \xB7 \u6CBC\u6CFD\u91CC\u7684\u820D\u4E0E\u5F97"
    Lines:
    - Speaker: "\u56E2\u56E2"
      Text: "\u8FD9\u7247\u6CBC\u6CFD\u541E\u4E0B\u4E86\u8BB8\u591A\u4E0D\u80AF\u540E\u9000\u7684\u961F\u4F0D\u3002\u5B83\u4EEC\u603B\u60F3\u5B88\u4F4F\u6BCF\u4E00\u683C\uFF0C\u6700\u540E\u5374\u8FDE\u8F6C\u8EAB\u7684\u7A7A\u95F4\u90FD\u6CA1\u6709\u3002"
    - Speaker: "\u5192\u9669\u5BB6"
      Text: "\u4E22\u6389\u4E00\u4E2A\u4F4D\u7F6E\uFF0C\u4E0D\u7B49\u4E8E\u4E22\u6389\u540C\u4F34\u3002\u53CA\u65F6\u6362\u4F4D\uFF0C\u628A\u6D3B\u8DEF\u7559\u51FA\u6765\u3002"
    - Speaker: "\u56E2\u56E2"
      Text: "\u68CB\u8C31\u4E0A\u539F\u6765\u5199\u7740\u201C\u53D6\u820D\u201D\u3002\u5B88\u8C31\u8005\u6700\u5BB3\u6015\u7684\uFF0C\u4E5F\u8BB8\u5C31\u662F\u627F\u8BA4\u81EA\u5DF1\u6709\u4E00\u6B65\u8D70\u9519\u4E86\u3002"
  - Id: chapter5
    Title: "\u7B2C\u4E94\u7AE0 \xB7 \u96EA\u539F\u7559\u4E00\u53E3\u6C14"
    Lines:
    - Speaker: "\u56E2\u56E2"
      Text: "\u98CE\u96EA\u628A\u8DEF\u90FD\u76D6\u4F4F\u4E86\uFF0C\u53EF\u540C\u4F34\u56F4\u51FA\u6765\u7684\u5C0F\u5C0F\u7A7A\u5730\u8FD8\u6696\u7740\u3002\u90A3\u5C31\u662F\u201C\u773C\u201D\u5427\uFF1F"
    - Speaker: "\u5192\u9669\u5BB6"
      Text: "\u662F\u3002\u771F\u6B63\u7684\u575A\u56FA\uFF0C\u4E0D\u662F\u628A\u6240\u6709\u5730\u65B9\u585E\u6EE1\uFF0C\u800C\u662F\u4E3A\u81EA\u5DF1\u7559\u4E0B\u547C\u5438\u548C\u53D8\u5316\u7684\u4F59\u5730\u3002"
    - Speaker: "\u56E2\u56E2"
      Text: "\u7B49\u89C1\u5230\u5B88\u8C31\u8005\uFF0C\u6211\u4E5F\u8981\u544A\u8BC9\u5B83\uFF1A\u6709\u7A7A\u767D\u7684\u68CB\u76D8\uFF0C\u4E00\u6837\u80FD\u4FDD\u62A4\u5927\u5BB6\u3002\u8D70\u5427\uFF0C\u795E\u6BBF\u5C31\u5728\u96EA\u5149\u540E\u9762\u3002"
  - Id: chapter6
    Title: "\u7B2C\u516D\u7AE0 \xB7 \u795E\u6BBF\u7EC8\u5C40"
    Lines:
    - Speaker: "\u5B88\u8C31\u8005"
      Text: "\u53EA\u8981\u628A\u6240\u6709\u6C14\u53E3\u5C01\u4F4F\uFF0C\u5C31\u4E0D\u4F1A\u518D\u6709\u5206\u79BB\u3001\u610F\u5916\u548C\u5931\u8D25\u3002\u4F60\u4EEC\u4E3A\u4EC0\u4E48\u8FD8\u8981\u6539\u53D8\u68CB\u5C40\uFF1F"
    - Speaker: "\u5192\u9669\u5BB6"
      Text: "\u56E0\u4E3A\u6D3B\u7740\u7684\u68CB\u5C40\u4F1A\u53D8\u5316\uFF0C\u670B\u53CB\u4E5F\u4F1A\u505A\u81EA\u5DF1\u7684\u9009\u62E9\u3002\u4F60\u5B88\u62A4\u7684\u4E16\u754C\uFF0C\u4E0D\u80FD\u53EA\u5269\u4E0B\u670D\u4ECE\u3002"
    - Speaker: "\u56E2\u56E2"
      Text: "\u6211\u4EEC\u4E0D\u4F1A\u9760\u4E00\u6B21\u5077\u56F4\u7ED3\u675F\u8FD9\u573A\u4E89\u8BBA\u3002\u5148\u6B63\u9762\u51FB\u7834\u5B83\u7684\u9632\u7EBF\uFF0C\u7B49\u738B\u7684\u751F\u547D\u8DB3\u591F\u4F4E\uFF0C\u518D\u5C01\u4F4F\u6700\u540E\u7684\u6C14\uFF0C\u5B8C\u6210\u201C\u64D2\u738B\u201D\uFF01"
    - Speaker: "\u5B88\u8C31\u8005"
      Text: "\u90A3\u5C31\u843D\u5B50\u5427\u3002\u8BA9\u6211\u770B\u770B\uFF0C\u4F60\u4EEC\u7559\u4E0B\u7684\u7A7A\u767D\uFF0C\u7A76\u7ADF\u80FD\u957F\u51FA\u4EC0\u4E48\u3002"
  - Id: ending
    Title: "\u5C3E\u58F0 \xB7 \u7559\u7ED9\u660E\u5929\u7684\u4E00\u624B"
    Lines:
    - Speaker: "\u65C1\u767D"
      Text: "\u6700\u540E\u4E00\u53E3\u6C14\u88AB\u5C01\u4F4F\uFF0C\u795E\u6BBF\u6CA1\u6709\u5D29\u584C\u3002\u516D\u9875\u68CB\u8C31\u6D6E\u5230\u7A7A\u4E2D\uFF0C\u62FC\u51FA\u7684\u5374\u662F\u4E00\u5F20\u7559\u6709\u7A7A\u767D\u7684\u68CB\u76D8\u3002"
    - Speaker: "\u5B88\u8C31\u8005"
      Text: "\u539F\u6765\u6211\u4E00\u76F4\u60F3\u5B88\u4F4F\u7684\uFF0C\u4E0D\u662F\u80DC\u5229\u2026\u2026\u662F\u5927\u5BB6\u613F\u610F\u518D\u6765\u4E0B\u4E00\u5C40\u3002"
    - Speaker: "\u56E2\u56E2"
      Text: "\u56DE\u5BB6\u7684\u95E8\u5F00\u5566\u3002\u5192\u9669\u5BB6\uFF0C\u4F60\u8FD8\u4F1A\u56DE\u6765\u5417\uFF1F\u6211\u8FD8\u6B20\u4F60\u4E00\u573A\u5802\u5802\u6B63\u6B63\u7684\u80DC\u5229\u5462\uFF01"
    - Speaker: "\u5192\u9669\u5BB6"
      Text: "\u4F1A\u7684\u3002\u66FF\u6211\u7559\u4E2A\u4F4D\u7F6E\u5427\u3002\u4E0B\u4E00\u624B\uFF0C\u6211\u4EEC\u660E\u5929\u518D\u4E0B\u3002"
  - Id: lesson
    Title: "\u661F\u843D\u68CB\u576A \xB7 \u52A8\u624B\u8BD5\u4E00\u8BD5"
    Lines:
    - Speaker: "\u56E2\u56E2"
      Text: "\u70B9\u51FB\u5DE6\u4FA7\u9B54\u6CD5\u6846\u4E2D\u7684\u5251\u58EB\u624B\u724C\uFF0C\u51C6\u5907\u843D\u5B50\u3002"
    - Speaker: "\u56E2\u56E2"
      Text: "\u70B9\u51FB\u654C\u4EBA\u4E0B\u65B9\u7684\u9B54\u6CD5\u6846\u7A7A\u683C\uFF0C\u5C01\u4F4F\u6700\u540E\u4E00\u53E3\u6C14\u3002"
    - Speaker: "\u56E2\u56E2"
      Text: "\u96F6\u6C14\u4F1A\u9650\u5236\u884C\u52A8\uFF0C\u4E0D\u4F1A\u76F4\u63A5\u6D88\u706D\u654C\u4EBA\u3002\u70B9\u51FB\u5DE6\u4FA7\u6846\u4E2D\u7684\u5DF1\u65B9\u68CB\u5B50\u3002"
    - Speaker: "\u56E2\u56E2"
      Text: "\u70B9\u51FB\u5DE6\u8FB9\u7684\u9B54\u6CD5\u6846\u7A7A\u683C\u6362\u4F4D\uFF0C\u89C2\u5BDF\u654C\u4EBA\u6062\u590D\u4E00\u53E3\u6C14\u3002"
    - Speaker: "\u56E2\u56E2"
      Text: "\u68CB\u5B50\u4F1A\u81EA\u52A8\u6218\u6597\u3002\u7B49\u5F85\u51C6\u5907\u589E\u76CA\u62B5\u8FBE\uFF0C\u518D\u70B9\u51FB\u5F00\u59CB\u6218\u6597\uFF01"
  - Id: boss_after_1
    Title: "\u7B2C\u4E00\u7AE0\u7EC8\u5E55 \xB7 \u661F\u5149\u76F8\u8FDE"
    Lines:
    - Speaker: "\u65C1\u767D"
      Text: "\u5DE1\u8DEF\u5251\u58EB\u7684\u94E0\u7532\u5316\u6210\u4E00\u4E32\u661F\u5C18\uFF0C\u843D\u8FDB\u68CB\u576A\u7684\u7F1D\u9699\u3002\u88AB\u5835\u4F4F\u7684\u5149\uFF0C\u7EC8\u4E8E\u53C8\u6D41\u5411\u4E86\u8FDC\u65B9\u3002"
    - Speaker: "\u5DE1\u8DEF\u5251\u58EB"
      Text: "\u6211\u4EE5\u4E3A\u7AD9\u5F97\u8D8A\u8FDC\uFF0C\u5C31\u8D8A\u4E0D\u4F1A\u8FDE\u7D2F\u540C\u4F34\u3002\u539F\u6765\u5B64\u5355\u7684\u68CB\u5B50\uFF0C\u624D\u6700\u5BB9\u6613\u5931\u53BB\u547C\u5438\u3002"
    - Speaker: "\u56E2\u56E2"
      Text: "\u7B2C\u4E00\u5F20\u68CB\u8C31\u56DE\u6765\u5566\uFF01\u5B83\u5199\u7740\uFF1A\u8FDE\u7ED3\u4E0D\u662F\u6324\u5728\u4E00\u8D77\uFF0C\u662F\u613F\u610F\u66FF\u670B\u53CB\u7559\u4E00\u6761\u8DEF\u3002"
    - Speaker: "\u5192\u9669\u5BB6"
      Text: "\u90A3\u6211\u4EEC\u6CBF\u7740\u8FD9\u6761\u661F\u5149\u8DEF\u53BB\u6751\u5B50\u3002\u4E0B\u4E00\u5C40\uFF0C\u4E5F\u4E00\u8D77\u4E0B\u3002"
  - Id: boss_after_2
    Title: "\u7B2C\u4E8C\u7AE0\u7EC8\u5E55 \xB7 \u9633\u5149\u4E0B\u7684\u4E00\u624B"
    Lines:
    - Speaker: "\u65C1\u767D"
      Text: "\u5F13\u624B\u6536\u8D77\u7D27\u7EF7\u7684\u5F26\u3002\u91D1\u8272\u9633\u5149\u7A7F\u8FC7\u6751\u95E8\uFF0C\u5C4B\u9876\u7684\u9B54\u6CD5\u706F\u4E00\u76CF\u63A5\u4E00\u76CF\u4EAE\u4E86\u8D77\u6765\u3002"
    - Speaker: "\u6751\u53E3\u5F13\u624B"
      Text: "\u6211\u4E00\u76F4\u5B88\u7740\u6700\u7A33\u7684\u9635\u5F62\uFF0C\u5374\u5FD8\u4E86\u6751\u95E8\u672C\u6765\u5C31\u662F\u4E3A\u4E86\u8FCE\u63A5\u5BA2\u4EBA\u3002"
    - Speaker: "\u5192\u9669\u5BB6"
      Text: "\u501F\u52BF\u4E0D\u53EA\u662F\u501F\u4E00\u9897\u68CB\u5B50\u7684\u529B\u91CF\u3002\u613F\u610F\u76F8\u4FE1\u5F7C\u6B64\uFF0C\u6574\u7247\u68CB\u76D8\u90FD\u4F1A\u6210\u4E3A\u6211\u4EEC\u7684\u540E\u76FE\u3002"
    - Speaker: "\u56E2\u56E2"
      Text: "\u7B2C\u4E8C\u9875\u68CB\u8C31\u5728\u53D1\u5149\uFF01\u6751\u957F\u8BF4\uFF0C\u955C\u6E56\u7684\u6C34\u6D41\u4F1A\u5E26\u6211\u4EEC\u627E\u5230\u7B2C\u4E09\u9875\u3002"
  - Id: boss_after_3
    Title: "\u7B2C\u4E09\u7AE0\u7EC8\u5E55 \xB7 \u653E\u5F00\u5012\u5F71"
    Lines:
    - Speaker: "\u65C1\u767D"
      Text: "\u6C34\u6CD5\u5E08\u7684\u5012\u5F71\u88AB\u6E56\u6D41\u8F7B\u8F7B\u5377\u8D70\u3002\u6E56\u9762\u9759\u4E0B\u6765\uFF0C\u9732\u51FA\u4E00\u6761\u901A\u5F80\u6CBC\u6CFD\u7684\u65E7\u6808\u9053\u3002"
    - Speaker: "\u6C34\u6CD5\u5E08"
      Text: "\u6211\u4E89\u6BCF\u4E00\u7247\u6C34\u9762\uFF0C\u53EA\u6015\u5931\u53BB\u4E00\u683C\u5C31\u4F1A\u5931\u53BB\u5168\u90E8\u3002\u53EF\u6525\u5F97\u8D8A\u7D27\uFF0C\u5012\u5F71\u5C31\u8D8A\u7834\u788E\u3002"
    - Speaker: "\u5192\u9669\u5BB6"
      Text: "\u820D\u6389\u4E00\u5904\uFF0C\u624D\u80FD\u7167\u987E\u66F4\u5927\u7684\u5C40\u9762\u3002\u68CB\u76D8\u4E0A\u7684\u53D6\u820D\uFF0C\u4E5F\u662F\u5728\u4E3A\u540C\u4F34\u7559\u4E0B\u9009\u62E9\u3002"
    - Speaker: "\u56E2\u56E2"
      Text: "\u7B2C\u4E09\u9875\u56DE\u6765\u5566\u3002\u524D\u9762\u6CE5\u6CDE\u7684\u8DEF\uFF0C\u5C31\u8BA9\u6211\u4EEC\u4E92\u76F8\u62C9\u7740\u8D70\u5427\uFF01"
  - Id: boss_after_4
    Title: "\u7B2C\u56DB\u7AE0\u7EC8\u5E55 \xB7 \u6CE5\u4E2D\u751F\u8DEF"
    Lines:
    - Speaker: "\u65C1\u767D"
      Text: "\u523A\u5BA2\u7684\u5F71\u5B50\u6C89\u5165\u6CE5\u6F6D\uFF0C\u7F20\u7ED5\u9053\u8DEF\u7684\u6CBC\u6C14\u6563\u5F00\u3002\u51E0\u682A\u65B0\u82BD\u4ECE\u521A\u7A7A\u51FA\u7684\u68CB\u683C\u91CC\u63A2\u51FA\u4E86\u5934\u3002"
    - Speaker: "\u6CBC\u6CFD\u523A\u5BA2"
      Text: "\u6211\u53EA\u4F1A\u5C01\u4F4F\u522B\u4EBA\u7684\u9000\u8DEF\u3002\u5230\u6700\u540E\uFF0C\u8FDE\u6211\u81EA\u5DF1\u4E5F\u627E\u4E0D\u5230\u51FA\u53E3\u3002"
    - Speaker: "\u56E2\u56E2"
      Text: "\u7B2C\u56DB\u9875\u5199\u7684\u662F\u201C\u6C14\u773C\u201D\uFF01\u7559\u4E00\u53E3\u6C14\uFF0C\u4E0D\u662F\u8F6F\u5F31\uFF0C\u662F\u8BA9\u6BCF\u4E2A\u540C\u4F34\u8FD8\u6709\u673A\u4F1A\u8F6C\u8EAB\u3002"
    - Speaker: "\u5192\u9669\u5BB6"
      Text: "\u4F60\u4E5F\u53EF\u4EE5\u91CD\u65B0\u9009\u4E00\u6761\u8DEF\u3002\u6211\u4EEC\u53BB\u96EA\u539F\uFF0C\u627E\u56DE\u5269\u4E0B\u7684\u68CB\u8C31\u3002"
  - Id: boss_after_5
    Title: "\u7B2C\u4E94\u7AE0\u7EC8\u5E55 \xB7 \u51B0\u5C01\u4E4B\u540E"
    Lines:
    - Speaker: "\u65C1\u767D"
      Text: "\u76FE\u536B\u88AB\u84DD\u767D\u51B0\u6676\u5305\u88F9\uFF0C\u51B0\u58F3\u968F\u5373\u88C2\u6210\u7EC6\u96EA\u3002\u5B83\u4ECD\u63E1\u7740\u76FE\uFF0C\u5374\u4E0D\u518D\u6321\u4F4F\u901A\u5F80\u795E\u6BBF\u7684\u8DEF\u3002"
    - Speaker: "\u96EA\u539F\u76FE\u536B"
      Text: "\u6211\u60F3\u7528\u6700\u539A\u7684\u76FE\u4FDD\u62A4\u5927\u5BB6\uFF0C\u5374\u628A\u5927\u5BB6\u90FD\u5173\u5728\u4E86\u98CE\u96EA\u91CC\u3002"
    - Speaker: "\u5192\u9669\u5BB6"
      Text: "\u771F\u6B63\u7684\u773C\u4F4D\u7ED9\u4EBA\u547C\u5438\uFF0C\u4E5F\u7ED9\u4EBA\u81EA\u7531\u3002\u5B88\u62A4\u4E0D\u5FC5\u586B\u6EE1\u6BCF\u4E00\u683C\uFF0C\u7A7A\u767D\u4E5F\u80FD\u6210\u4E3A\u6E29\u6696\u3002"
    - Speaker: "\u56E2\u56E2"
      Text: "\u7B2C\u4E94\u9875\u5230\u624B\uFF01\u628A\u8FD9\u4EFD\u4FE1\u4EFB\u5E26\u7ED9\u5B88\u8C31\u8005\u5427\u3002\u5B83\u7B49\u90A3\u6700\u540E\u4E00\u624B\uFF0C\u5DF2\u7ECF\u592A\u4E45\u4E86\u3002"
  - Id: boss_after_6
    Title: "\u7B2C\u516D\u7AE0\u7EC8\u5E55 \xB7 \u7559\u7ED9\u660E\u5929\u7684\u4E00\u624B"
    Lines:
    - Speaker: "\u65C1\u767D"
      Text: "\u5341\u5B57\u5723\u5149\u5212\u5F00\u795E\u6BBF\u7684\u7A79\u9876\u3002\u516D\u9875\u68CB\u8C31\u5408\u4E3A\u4E00\u4F53\uFF0C\u62FC\u51FA\u7684\u7ADF\u662F\u4E00\u5F20\u7559\u6709\u7A7A\u767D\u7684\u68CB\u76D8\u3002"
    - Speaker: "\u5B88\u8C31\u8005"
      Text: "\u4F60\u4EEC\u6B63\u9762\u7834\u5F00\u6211\u7684\u9632\u7EBF\uFF0C\u4E5F\u8BA9\u6211\u770B\u89C1\u4E86\u6700\u540E\u4E00\u53E3\u6C14\u3002\u539F\u6765\u4E16\u754C\u9700\u8981\u7684\u4E0D\u662F\u6C38\u8FDC\u4E0D\u53D8\u7684\u80DC\u5C40\u3002"
    - Speaker: "\u5192\u9669\u5BB6"
      Text: "\u662F\u613F\u610F\u7EE7\u7EED\u4E0B\u68CB\u7684\u670B\u53CB\u3002\u4F1A\u8F93\uFF0C\u4F1A\u6539\u53D8\uFF0C\u4E5F\u4F1A\u4E00\u8D77\u5F00\u59CB\u4E0B\u4E00\u5C40\u3002"
    - Speaker: "\u56E2\u56E2"
      Text: "\u56DE\u5BB6\u7684\u95E8\u5F00\u5566\uFF01\u5192\u9669\u5BB6\uFF0C\u4F60\u8FD8\u4F1A\u56DE\u6765\u5417\uFF1F\u6211\u8FD8\u6B20\u4F60\u4E00\u573A\u5802\u5802\u6B63\u6B63\u7684\u80DC\u5229\u5462\uFF01"
    - Speaker: "\u5192\u9669\u5BB6"
      Text: "\u4F1A\u7684\u3002\u66FF\u6211\u7559\u4E2A\u4F4D\u7F6E\u5427\u3002\u4E0B\u4E00\u624B\uFF0C\u6211\u4EEC\u660E\u5929\u518D\u4E0B\u3002"
