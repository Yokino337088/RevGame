        Atlas: 
      Expression: 12
      Text: "\u53EA\u80FD\u5FA1\u5BD2\uFF1F\u6CA1\u6709\u522B\u7684\u529F\u80FD\u5417(\u7B11)"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 13
      Text: "\u4E0D\u7136\u5462\uFF01\u4F60\u8FD8\u60F3\u8BA9\u672C\u9E26\u63D0\u4F9B\u4EC0\u4E48\u670D\u52A1\uFF1F\u2026\u2026\u62A4\u80FD\u7B26\u5728\u6211\u5DE6\u8FB9\uFF0C\u5FEB\u9760\u8FD1\u4E00\u70B9\uFF01(\u5BB3\u7F9E)"
