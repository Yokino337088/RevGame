  - Id: chapter6
    Title: "\u7B2C\u516D\u7AE0 \xB7 \u795E\u6BBF"
    Portrait: {fileID: 0}
    PortraitReference:
      AssetGuid: 
      LocalId: 0
      SpriteName: 
      Atlas: 
    BackgroundChapter: 6
    Lines:
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 3
      Text: "\u795E\u6BBF\u5C31\u5728\u773C\u524D\uFF0C\u8FD9\u662F\u6700\u540E\u7684\u8BD5\u70BC\u3002\u6700\u540E\u4E00\u9875\u68CB\u8C31\uFF0C\u548C\u56DE\u53BB\u7684\u8DEF\uFF0C\u90FD\u5728\u90A3\u91CC\u3002"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 5
      Text: "\u62FF\u5230\u4E4B\u540E\uFF0C\u4F60\u5927\u6982\u5C31\u4E0D\u7528\u7EE7\u7EED\u88AB\u6211\u5632\u8BBD\u4E86\uFF0C\u5F88\u9AD8\u5174\u5427\uFF1F"
    - Speaker: "\u5192\u9669\u5BB6"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 10
      Text: "\u4F46\u662F\u6211\u6709\u70B9\u4E0D\u60F3\u8D70\u4E86\u600E\u4E48\u529E\uFF0C\u6211\u5DF2\u7ECF\u4E50\u4E0D\u601D\u8700\u4E86(\u7B11)"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 2
      Text: "\u54E6\uFF0C\u4E8B\u6210\u4E4B\u540E\u672C\u9E26\u53EF\u8981\u53CD\u6094\u4E86\u54E6(\u574F\u7B11)"
    - Speaker: "\u5192\u9669\u5BB6"
      Portrait: {fileID: 0}
      PortraitReference:
        AssetGuid: 
        LocalId: 0
        SpriteName: 
        Atlas: 
      Expression: 14
      Text: "\u554A\uFF0C\u6211\u53EA\u662F\u5F00\u4E2A\u73A9\u7B11\u800C\u5DF2\uFF0C\u4F60\u4E0D\u4F1A\u771F\u8981\u8BA9\u6211\u7559\u4E0B\u4E86\u7ED9\u4F60\u505A\u4E00\u8F88\u5B50\u7684\u5BB6\u52A1\u5427(\u60B2)"
    - Speaker: "\u9E26\u9E26"
      Portrait: {fileID: 0}
