      "environment": "either",
      "readOnly": true
    },
    {
      "id": "build.scene-add",
      "keys": [
        "path",
        "enabled"
      ],
      "description": "把场景加入 Build Settings，已存在时只更新启用状态",
      "environment": "edit",
      "readOnly": false
    },
    {
      "id": "build.scene-remove",
      "keys": [
        "path"
      ],
      "description": "把场景移出 Build Settings，不删除场景文件；不在列表时不报错",
      "environment": "edit",
      "readOnly": false
    },
    {
      "id": "excel.check",
      "keys": [],
      "description": "导表前体检：代码目录、容器目录、数据目录是否可写可用，以及数据目录所在 AB 包",
      "environment": "either",
      "readOnly": true
    },
    {
      "id": "excel.preview",
      "keys": [
        "sources",
        "recursive",
        "table",
        "offset",
        "limit"
      ],
      "description": "预览 Excel：不给 table 时列出每张表的字段数、行数、是否忽略和错误；给 table 时返回字段、分页行和带行号的错误。坏表也会返回详情，不直接失败",
      "environment": "either",
      "readOnly": true
    },
    {
      "id": "ab.issues",
      "keys": [
        "target"
      ],
      "description": "返回 AB 检查页的结构化问题：校验错误与警告、同包重名、被多包重复引用的资源、循环依赖、映射一致性；有问题也正常返回，canBuild 表示能否打包",
      "environment": "edit",
      "readOnly": true
    },
    {
      "id": "ab.extract-shared",
      "keys": [
        "bundle",
        "assets"
      ],
      "description": "把被多个包重复引用的资源移进共享包，消除重复打包；不给 assets 时处理全部重复资源，需要 confirm",
      "environment": "edit",
      "readOnly": false
    },
    {
      "id": "ab.top-assets",
      "keys": [
        "bundle",
        "limit"
      ],
      "description": "按源文件体积列出最大的资源，可限定某个包，用于定位包体热点",
      "environment": "edit",
      "readOnly": true
    }
